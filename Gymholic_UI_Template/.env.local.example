# Copy to .env.local and fill in real values. Without these, the app still
# runs, but no orders/bookings are persisted and no emails are sent — every
# call logs a clear warning instead of silently pretending to succeed.

# Resend (resend.com) — transactional email for order receipts and
# booking confirmations/reminders.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain for real delivery.
FROM_EMAIL="Gymholic <hello@yourdomain.com>"

# Upstash Redis (upstash.com, or the Vercel KV integration which provisions
# the same thing) — shared storage for booked slots and stored orders, so
# a paid slot is actually unavailable to every visitor, not just one browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
