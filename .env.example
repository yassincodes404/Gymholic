# ========================
# Gymholic Environment Variables
# ========================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---- Application ----
SPRING_PROFILES_ACTIVE=dev

# ---- Database ----
POSTGRES_DB=gymholic
POSTGRES_USER=gymholic
POSTGRES_PASSWORD=changeme

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT ----
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Admin Seed (Development/Testing) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
# Emails that get ADMIN on sign-in (comma-separated). Only for the owner
# and trusted experts — never hand this out broadly.
ADMIN_BOOTSTRAP_EMAILS=
# Shared secret that hides the admin portal. Without it /api/admin/auth/*
# answers 404, and the frontend /admin pages return 404 until visited with
# ?key=<ADMIN_ACCESS_KEY> (which sets an access cookie for that browser).
# Generate: openssl rand -hex 24
ADMIN_ACCESS_KEY=

# ---- Zoom (optional; real meetings instead of Google Meet) ----
# Server-to-Server OAuth app from https://marketplace.zoom.us
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Google OAuth / Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback the Google Cloud Console redirects to
# (backend exposes it at /api/integrations/google/callback)
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
# AES key (any long random string) used to encrypt stored Google refresh tokens
ENCRYPTION_SECRET=

# Frontend Google Sign-In (same Client ID, safe to expose)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Paymob ----
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# Optional: force the currency sent to Paymob (e.g. EGP) when the account
# cannot collect USD. Empty = use the order currency (USD).
PAYMOB_CURRENCY=

# ---- Email (production: Brevo / SMTP) ----
# Preferred production setup is Brevo (https://www.brevo.com, free tier: 300
# emails/day). Either paste the API key in Admin → Integrations → Transactional
# Email (stored encrypted in the DB) or set BREVO_API_KEY here — the admin UI
# takes precedence. With no Brevo key the app falls back to the SMTP settings
# below (e.g. Gmail with an App Password: https://myaccount.google.com/apppasswords).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gymholic
# SMS sender name for phone-verification codes (alphanumeric, max 11 chars).
# Uses the same Brevo account/API key; SMS credits are billed separately.
BREVO_SMS_SENDER=Gymholic
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_FROM=noreply@gymholic.com
MAIL_FROM_NAME=Gymholic
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Auth ----
# One-time email codes confirm every sign-up / sign-in. Set to false ONLY for
# local development or emergency recovery (payments then skip verification).
EMAIL_VERIFICATION_REQUIRED=true
# Phone numbers must be confirmed with an SMS code (Brevo) before booking or
# ordering. Requires Brevo SMS to be configured — set to false only as an
# emergency rollback (e.g. SMS credits exhausted).
PHONE_VERIFICATION_REQUIRED=true

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_URL=http://localhost:3000
