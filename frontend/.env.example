# Backend API base URL.
# Local dev usually uses http://localhost:8080/api.
# Production should stay /api so the edge proxy (Traefik) can route it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Gymholic currently books against one default trainer profile in the backend.
NEXT_PUBLIC_DEFAULT_TRAINER_ID=1

# Optional email / storage integrations for the template's own server routes.
RESEND_API_KEY=
FROM_EMAIL="Gymholic <hello@yourdomain.com>"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
