# ========================
# Gymholic Environment Variables
# ========================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---- Application ----
SPRING_PROFILES_ACTIVE=dev

# ---- Database ----
POSTGRES_DB=gymholic
POSTGRES_USER=gymholic
POSTGRES_PASSWORD=changeme

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT ----
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Admin Seed (Development/Testing) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ---- Google OAuth / Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth callback the Google Cloud Console redirects to
# (backend exposes it at /api/integrations/google/callback)
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
# AES key (any long random string) used to encrypt stored Google refresh tokens
ENCRYPTION_SECRET=

# Frontend Google Sign-In (same Client ID, safe to expose)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Paymob ----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ---- Email (Gmail SMTP) ----
# Booking confirmations, payment receipts, calendar invites and reminders are
# sent through this account. Use a Google Account with 2FA enabled and an
# App Password (https://myaccount.google.com/apppasswords) as MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=yourgmailaddress@gmail.com
MAIL_USERNAME=yourgmailaddress@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_URL=http://localhost:5173
